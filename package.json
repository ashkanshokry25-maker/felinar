{
  "name": "felinar",
  "version": "0.3.0",
  "description": "felinar: websites loaded by magnet link, verified in your browser, from a plain static host. No backend. The light web.",
  "keywords": [
    "webtorrent",
    "bittorrent",
    "magnet-link",
    "peer-to-peer",
    "p2p",
    "webrtc",
    "service-worker",
    "static-site",
    "static-hosting",
    "web-seed",
    "site-ledger",
    "no-backend"
  ],
  "homepage": "https://github.com/ashkanshokry25-maker/felinar#readme",
  "bugs": {
    "url": "https://github.com/ashkanshokry25-maker/felinar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashkanshokry25-maker/felinar.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "felinar": "bin/felinar.mjs",
    "magnet-web": "bin/felinar.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "tools/",
    "build.mjs",
    "build.lock.json",
    "npm-shrinkwrap.json",
    "test/e2e/browser-args.mjs"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=11.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:idp": "node tools/build-idp.mjs",
    "test": "npm run lint:floor && npm run test:unit",
    "test:unit": "node tools/run-unit.mjs",
    "test:browser": "node tools/run-unit.mjs --browser",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:webkit": "node test/e2e/run.mjs --webkit",
    "test:e2e:firefox": "node test/e2e/run.mjs --firefox",
    "test:fuzz": "node test/fuzz/run.mjs",
    "test:example": "node --test \"test/example/*.test.mjs\"",
    "check:example": "node test/example/check-html.mjs",
    "lint:floor": "node tools/lint-floor.mjs",
    "tracker": "node tools/tracker.mjs",
    "dev": "node tools/dev-server.mjs",
    "publish:site": "node tools/publish.mjs",
    "keygen": "node tools/keygen.mjs",
    "ledger": "node tools/ledger-admin.mjs",
    "init": "node tools/init.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "pin": "node tools/pin.mjs",
    "seed": "node tools/seed.mjs",
    "ship": "node tools/ship.mjs",
    "demo": "node tools/demo.mjs",
    "check:webseed": "node tools/check-webseed.mjs",
    "check:site": "node tools/check-site.mjs",
    "snapshot": "node tools/snapshot.mjs"
  },
  "dependencies": {
    "bittorrent-tracker": "^11.2.3",
    "create-torrent": "^6.1.3",
    "magnet-uri": "^7.0.10",
    "parse-torrent": "^11.0.24",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "playwright": "^1.64.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bufferutil": false,
    "utf-8-validate": false,
    "utp-native": false,
    "ip-set": false,
    "node-datachannel": false
  }
}
