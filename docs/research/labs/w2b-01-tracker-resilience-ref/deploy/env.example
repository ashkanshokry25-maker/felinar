# /etc/magnet-tracker/env  (EnvironmentFile for magnet-tracker.service; no quotes, one KEY=VALUE per line)
HOST=127.0.0.1
PORT=8000
METRICS_PORT=9464
# Told to clients as `interval`. The stock WebTorrent client then announces this often (and creates up to numwant offers each time).
ANNOUNCE_INTERVAL_S=120
# Either list the info hashes this tracker serves (one 40-hex per line, # comments, SIGHUP reloads; the file must exist: start from allow.example.txt) ...
ALLOW_FILE=/etc/magnet-tracker/allow.txt
# ... or run open (anyone can use it as free signalling): OPEN=1
#OPEN=1
# Browsers always send Origin; refuse other websites from using this tracker (does not stop non-browser clients).
ALLOW_ORIGINS=https://example.com,https://www.example.com
MAX_CONNECTIONS=20000
MAX_CONN_PER_IP=200
PING_INTERVAL_S=30
LOG_LEVEL=info
